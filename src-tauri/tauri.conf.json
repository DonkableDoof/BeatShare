{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BeatShare",
  "version": "0.1.0",
  "identifier": "com.beatshare.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "node scripts/dev.mjs",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BeatShare",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGMTA2QkMyQ0VENzk5NTIKUldSU21kZk93bXNRcjdsUE41YmlkVGZDQUpiR3Vham53dzdhVGpBeW5WVU1MNDlpY21qQ0M3T2oK",
      "endpoints": [
        "https://github.com/DonkableDoof/BeatShare/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
